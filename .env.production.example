APP_NAME="Revelation Hour Ministries International"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.org
APP_TIMEZONE=Africa/Kampala

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rhmi
DB_USERNAME=rhmi_user
DB_PASSWORD=CHANGE_THIS

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
PUBLIC_CACHE_TTL=300
FILESYSTEM_DISK=public

# VPS with Redis:
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FORCE_HTTPS=true
SECURITY_HSTS=true
CSP_REPORT_ONLY=false
MAX_REQUEST_MB=550

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_THIS
MAIL_PASSWORD=CHANGE_THIS
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=website@example.org
MAIL_FROM_NAME="${APP_NAME}"
